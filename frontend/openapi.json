          },
          "that_id": {
            "type": "integer",
            "title": "That Id"
          },
          "this_id": {
            "type": "integer",
            "title": "This Id"
          }
        },
        "type": "object",
        "required": [
          "direction",
          "name",
          "that_id",
          "this_id"
        ],
        "title": "LocalityEdge"
      },
      "LocalityResponse": {
        "properties": {
          "countries": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Countries"
          },
          "edge_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Edge Counts"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/LocalityEdge"
            },
            "type": "array",
            "title": "Edges"
          },
          "formats": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Formats"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Genres"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "styles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Styles"
          },
          "vertices": {
            "items": {
              "$ref": "#/components/schemas/LocalityVertex"
            },
            "type": "array",
            "title": "Vertices"
          }
        },
        "type": "object",
        "required": [
          "countries",
          "edge_counts",
          "edges",
          "formats",
          "genres",
          "id",
          "pagination",
          "styles",
          "vertices"
