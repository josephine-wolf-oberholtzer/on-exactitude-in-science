            "title": "Child Count"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "distance": {
            "type": "integer",
            "title": "Distance"
          },
          "eid": {
            "type": "integer",
            "title": "Eid"
          },
          "formats": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Formats"
          },
          "genres": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Genres"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Index"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "position": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "styles": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Styles"
          },
          "videos": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/VideoDict"
                },
                "type": "array"
              },
              {
                "type": "null"
