{
  "openapi": "3.1.0",
  "info": {
    "title": "On Exactitude in Science",
    "version": "0.1.0"
  },
  "paths": {
    "/entity/": {
      "get": {
        "tags": [
          "entity"
        ],
        "summary": "Get Entity",
        "description": "Look up a single entity by its ID and label.\n\nMost entities have an index of 0. A track shares its release's ID, so the\nindex picks out the track.",
        "operationId": "get_entity_entity__get",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Id"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/VertexLabelName"
            }
          },
          {
            "name": "index",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Index"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "description": "Liveness: the process is up and able to serve requests.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "description": "Readiness: the database is reachable.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Readyz Readyz Get"
                }
              }
            }
          }
        }
      }
    },
    "/startupz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Startupz",
        "description": "Startup: the lifespan has run and the engine has been created.",
        "operationId": "startupz_startupz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Startupz Startupz Get"
                }
              }
            }
          }
        }
      }
    },
    "/locality/": {
      "get": {
        "tags": [
          "locality"
        ],
        "summary": "Get Locality",
        "description": "Get the neighborhood of an entity: nearby vertices and the edges among them.\n\nThe response carries the center vertex's edge counts, grouped by edge name,\nand every vertex carries a count of its children.",
        "operationId": "get_locality_locality__get",
        "parameters": [
          {
            "name": "eid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Eid"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/VertexLabelName"
            }
          },
          {
            "name": "countries",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Countries"
            }
          },
          {
            "name": "formats",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Formats"
            }
          },
          {
            "name": "genres",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Genres"
            }
          },
          {
            "name": "index",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Index"
            }
          },
          {
            "name": "labels",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/components/schemas/VertexLabelName"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Labels"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "One-based page number",
              "default": 1,
              "title": "Page"
            },
            "description": "One-based page number"
          },
          {
            "name": "roles",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Roles"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 2,
              "description": "Maximum vertices per page, including the center vertex",
              "default": 500,
              "title": "Size"
            },
            "description": "Maximum vertices per page, including the center vertex"
          },
          {
            "name": "styles",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Styles"
            }
          },
          {
            "name": "years",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d*:\\d*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive range of years as START:END. Either end may be left empty: 1990:1999, 1990:, :1999",
              "title": "Years"
            },
            "description": "Inclusive range of years as START:END. Either end may be left empty: 1990:1999, 1990:, :1999"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalityResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/random/": {
      "get": {
        "tags": [
          "random"
        ],
        "summary": "Get Random Entity",
        "description": "Redirect to a random entity, optionally restricted by label.",
        "operationId": "get_random_entity_random__get",
        "parameters": [
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/VertexLabelName"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Label"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/search/": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Get Entities By Name",
        "description": "Search entities by name, most similar first.\n\nFewer than three characters returns no results.",
        "operationId": "get_entities_by_name_search__get",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Name to search for",
              "title": "Name"
            },
            "description": "Name to search for"
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/VertexLabelName"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Label"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Direction": {
        "type": "integer",
        "enum": [
          -1,
          0,
          1
        ],
        "title": "Direction"
      },
      "EntityResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "index",
          "label",
          "name",
          "url"
        ],
        "title": "EntityResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LocalityEdge": {
        "properties": {
          "direction": {
