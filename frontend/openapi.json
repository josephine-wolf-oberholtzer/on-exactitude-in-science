            "title": "Videos"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          }
        },
        "type": "object",
        "required": [
          "distance",
          "eid",
          "id",
          "label",
          "name"
        ],
        "title": "LocalityVertex"
      },
      "Pagination": {
