{
	"name": "on-exactitude-in-science-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"api:schema": "cd ../backend && uv run python -c \"import json; from maps.api import create_app; print(json.dumps(create_app().openapi(), indent=2))\" > ../frontend/openapi.json",
		"api:types": "npx --yes openapi-typescript@7.13.0 openapi.json -o src/api/schema.d.ts",
		"build": "tsc -b && vite build",
		"dev": "vite",
		"format": "biome format --write .",
		"lint": "biome check .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.6.0",
		"@mui/material": "^9.6.0",
		"@reduxjs/toolkit": "^2.15.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-redux": "^9.3.1",
		"react-router": "^8.5.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"jsdom": "^31.0.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
